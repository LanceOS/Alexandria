{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alexandria.local/schemas/module.schema.json",
  "title": "Alexandria module",
  "description": "Original lesson content. File loading also checks IDs, sibling positions, source URLs, and reader payload limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versionId", "slug", "title", "summary", "position", "objectives", "parts", "sources"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "id": { "$ref": "#/definitions/id" },
    "versionId": { "$ref": "#/definitions/id" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Published release number; omitted means 1. Use a new versionId when advancing an existing module by one release." },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "pattern": "\\S", "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 5000 },
    "position": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "objectives": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "\\S", "maxLength": 1000 }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "blocks"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "pattern": "\\S", "maxLength": 500 },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/definitions/block" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "authors", "url", "locator"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "pattern": "\\S", "maxLength": 500 },
          "authors": { "type": "array", "maxItems": 30, "items": { "type": "string", "pattern": "\\S", "maxLength": 300 } },
          "publisher": { "type": "string", "pattern": "\\S", "maxLength": 300 },
          "publicationYear": { "type": "integer", "minimum": 1, "maximum": 9999 },
          "edition": { "type": "string", "pattern": "\\S", "maxLength": 100 },
          "isbn": { "type": "string", "pattern": "\\S", "maxLength": 32 },
          "url": { "type": "string", "pattern": "^https?://[^\\s\\\\]+$", "maxLength": 2000 },
          "locator": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 100 },
    "text": { "type": "string", "pattern": "\\S", "maxLength": 30000 },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": { "type": { "const": "paragraph" }, "text": { "$ref": "#/definitions/text" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "language", "code"],
          "properties": {
            "type": { "const": "code" },
            "language": { "enum": ["cpp", "text", "shell"] },
            "code": { "type": "string", "pattern": "\\S", "maxLength": 40000 },
            "caption": { "type": "string", "pattern": "\\S", "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "text"],
          "properties": {
            "type": { "const": "callout" },
            "title": { "type": "string", "pattern": "\\S", "maxLength": 500 },
            "text": { "$ref": "#/definitions/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "list" },
            "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "pattern": "\\S", "maxLength": 5000 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "prompt", "explanation"],
          "properties": {
            "type": { "const": "reflection" },
            "prompt": { "type": "string", "pattern": "\\S", "maxLength": 5000 },
            "explanation": { "$ref": "#/definitions/text" }
          }
        }
      ]
    }
  }
}
