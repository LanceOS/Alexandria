{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alexandria.local/schemas/unit.schema.json",
  "title": "Alexandria unit",
  "description": "A unit.json describes its directory. Only the topic root includes topic metadata; nested directories define child units.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "slug", "description", "position"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "pattern": "\\S", "maxLength": 200 },
    "slug": { "$ref": "#/definitions/slug" },
    "description": { "type": "string", "maxLength": 5000 },
    "position": { "$ref": "#/definitions/position" },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "description", "categories"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "pattern": "\\S", "maxLength": 200 },
        "slug": { "$ref": "#/definitions/slug" },
        "description": { "type": "string", "maxLength": 5000 },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "position"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "position": { "$ref": "#/definitions/position" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 100 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "position": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
