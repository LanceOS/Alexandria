# Local development defaults. Copy this file to .env.
# Environment variables set by the shell take precedence over .env.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Set production mode when serving the compiled frontend with npm start.
# NODE_ENV=production

# Optional canonical browser origin. Use an origin only, without a path.
# APP_ORIGIN=http://localhost:3000
# Use the exact browser origin (http://localhost:5173 for Vite development).
# Behind an HTTPS proxy, use its public https:// origin to enable Secure cookies.

# Optional persistent storage overrides. Use absolute paths; ~ is not expanded.
# Omit these for the default storage location in your user data directory.
# DATA_DIR=/srv/alexandria/data
# DATABASE_PATH=/srv/alexandria/data/database/alexandria.sqlite

# Keep backups outside DATA_DIR.
# BACKUP_DIR=/srv/alexandria/backups

# Optional local C++20 execution. Requires rootless Podman and the prepared image.
# See docs/code-runner.md. Missing runner setup leaves library browsing available.
# CODE_RUNNER_ENABLED=true
# CODE_RUNNER_IMAGE=localhost/alexandria-cpp-runner:1
