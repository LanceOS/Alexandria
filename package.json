{
  "name": "alexandria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, self-hosted place to learn.",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx server/commands/init.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/commands/migrate.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx server/commands/backup.ts",
    "account:create": "node --env-file-if-exists=.env --import tsx server/commands/account-create.ts",
    "account:password": "node --env-file-if-exists=.env --import tsx server/commands/account-password.ts",
    "content:cpp-basics": "node --env-file-if-exists=.env --import tsx server/commands/content-cpp-basics.ts",
    "content:check": "node --import tsx server/commands/content-check.ts",
    "content:test-examples": "node scripts/check-cpp-examples.mjs",
    "runner:setup": "node --env-file-if-exists=.env scripts/setup-code-runner.mjs",
    "runner:check": "node --env-file-if-exists=.env --import tsx scripts/check-code-runner.mjs",
    "content:import": "node --env-file-if-exists=.env --import tsx server/commands/content-import.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:client": "node scripts/test.mjs client",
    "test:server": "node scripts/test.mjs server",
    "build": "npm run typecheck && npm run content:check && node scripts/clean-build.mjs && vite build && tsc -p tsconfig.server.json && node scripts/copy-content.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "ajv": "8.20.0",
    "animejs": "^4.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
